/*
 * Janus v1 handshake — Tamarin model.
 *
 * Symbolic (Dolev-Yao) model of the three-message handshake of
 * docs/PROTOCOL.md §6. The attacker controls the network and may, at any
 * time:
 *   - reveal any agent's long-term keys            (RevLtk),
 *   - break Ed25519 / ML-DSA-65 (forge for anyone)  (BreakEd / BreakDsa),
 *   - break X25519 / ML-KEM-768 (recover any
 *     session's ephemeral secret)                   (BreakX / BreakK).
 *
 * The lemmas state that each property holds unless the attacker broke
 * BOTH primitives of the relevant pair (or compromised the right long-term
 * key before the session). This is the hybrid claim of DESIGN.md §6.
 *
 * Abstractions (see formal/README.md): hashes, HKDF and HMAC are modelled
 * as a free hash function over tagged tuples; ML-KEM is an ideal KEM;
 * signatures are ideal (unforgeable without the key); fixed-length fields,
 * version bytes and randoms are kept as distinct terms. Breaking a primitive
 * is modelled by giving the attacker the corresponding secrets.
 */

theory Janus
begin

builtins: diffie-hellman, hashing

functions:
    pk_ed/1, sign_ed/2, verify_ed/3,
    pk_dsa/1, sign_dsa/2, verify_dsa/3,
    true/0,
    kem_pk/1, encaps/2, decaps/2

equations:
    verify_ed(sign_ed(m, sk), m, pk_ed(sk)) = true,
    verify_dsa(sign_dsa(m, sk), m, pk_dsa(sk)) = true,
    decaps(encaps(k, kem_pk(dk)), dk) = k

restriction Equality:
    "All x y #i. Eq(x, y) @i ==> x = y"

/* ───────────── identities ───────────── */

// Every agent has one hybrid identity. A peer's public identity is
// obtained through !Pk, which models the pinned fingerprint: an agent only
// accepts the identity that is pinned for the peer it wants to talk to.
rule Register:
    [ Fr(~ske), Fr(~skd) ]
  --[ Register($A), OnlyOnce($A) ]->
    [ !Ltk($A, ~ske, ~skd), !Pk($A, pk_ed(~ske), pk_dsa(~skd)),
      Out(<$A, pk_ed(~ske), pk_dsa(~skd)>) ]

restriction register_once:
    "All A #i #j. OnlyOnce(A) @i & OnlyOnce(A) @j ==> #i = #j"

/* ───────────── compromise ───────────── */

rule Reveal_Ltk:
    [ !Ltk($A, ske, skd) ]  --[ RevLtk($A) ]->  [ Out(<ske, skd>) ]

// A broken signature scheme lets the attacker sign as anyone.
rule Break_Ed:
    [ !Ltk($A, ske, skd) ]  --[ BreakEd() ]->   [ Out(ske) ]

rule Break_Dsa:
    [ !Ltk($A, ske, skd) ]  --[ BreakDsa() ]->  [ Out(skd) ]

// A broken KEM lets the attacker recover any session's ephemeral secret.
rule Break_X:
    [ !EphX(x) ]            --[ BreakX() ]->    [ Out(x) ]

rule Break_K:
    [ !EphK(dk) ]           --[ BreakK() ]->    [ Out(dk) ]

/* ───────────── handshake ───────────── */

// Client: ClientHello = <'ch', c_random, ML-KEM ek, X25519 share>.
rule Client_1:
    [ Fr(~x), Fr(~dk), Fr(~rc), !Ltk($C, skeC, skdC), !Pk($S, pkeS, pkdS) ]
  --[ ClientStart($C, $S) ]->
    [ St_C1($C, $S, ~x, ~dk, ~rc),
      !EphX(~x), !EphK(~dk),
      Out(<'ch', ~rc, kem_pk(~dk), 'g' ^ ~x>) ]

// Server: encapsulate, derive prk from TH(kex) and ss_mlkem || ss_x25519,
// sign TH(.. || id_S) with both schemes, MAC TH(.. || sig_S).
rule Server_1:
    let ch     = <'ch', rc, ekC, XC>
        ct     = encaps(~kk, ekC)
        YS     = 'g' ^ ~y
        idS    = <pk_ed(skeS), pk_dsa(skdS)>
        th_kex = h(<'transcript', ch, 'sh', ~rs, ct, YS>)
        prk    = h(<'extract', th_kex, ~kk, XC ^ ~y>)
        th_id  = h(<'transcript', ch, 'sh', ~rs, ct, YS, idS>)
        m_s    = <'hybrid-sig', 'server signature', idS, th_id>
        sig_e  = sign_ed(m_s, skeS)
        sig_d  = sign_dsa(m_s, skdS)
        th_sig = h(<'transcript', ch, 'sh', ~rs, ct, YS, idS, sig_e, sig_d>)
        fin_s  = h(<'hmac', h(<'s finished', prk>), th_sig>)
        sh     = <'sh', ~rs, ct, YS, idS, sig_e, sig_d, fin_s>
    in
    [ In(ch), Fr(~y), Fr(~kk), Fr(~rs), !Ltk($S, skeS, skdS) ]
  --[ Running_S($S, <ch, sh>) ]->
    [ St_S1($S, ch, sh, prk), !EphX(~y), Out(sh) ]

// Client: check pin, both signatures and the Finished MAC; answer.
rule Client_2:
    let ch     = <'ch', ~rc, kem_pk(~dk), 'g' ^ ~x>
        idS    = <pkeS, pkdS>
        sh     = <'sh', rs, ct, YS, idS, sig_e, sig_d, fin_s>
        th_kex = h(<'transcript', ch, 'sh', rs, ct, YS>)
        prk    = h(<'extract', th_kex, decaps(ct, ~dk), YS ^ ~x>)
        th_id  = h(<'transcript', ch, 'sh', rs, ct, YS, idS>)
        m_s    = <'hybrid-sig', 'server signature', idS, th_id>
        th_sig = h(<'transcript', ch, 'sh', rs, ct, YS, idS, sig_e, sig_d>)
        idC    = <pk_ed(skeC), pk_dsa(skdC)>
        th_cid = h(<'transcript', ch, sh, 'cf', idC>)
        m_c    = <'hybrid-sig', 'client signature', idC, th_cid>
        sc_e   = sign_ed(m_c, skeC)
        sc_d   = sign_dsa(m_c, skdC)
        th_csg = h(<'transcript', ch, sh, 'cf', idC, sc_e, sc_d>)
        fin_c  = h(<'hmac', h(<'c finished', prk>), th_csg>)
        cf     = <'cf', idC, sc_e, sc_d, fin_c>
        th_fin = h(<'transcript', ch, sh, cf>)
        key    = h(<'traffic', prk, th_fin>)
    in
    [ St_C1($C, $S, ~x, ~dk, ~rc), In(sh),
      !Ltk($C, skeC, skdC), !Pk($S, pkeS, pkdS) ]       // pinned server identity
  --[ Eq(verify_ed(sig_e, m_s, pkeS), true),
      Eq(verify_dsa(sig_d, m_s, pkdS), true),
      Eq(fin_s, h(<'hmac', h(<'s finished', prk>), th_sig>)),
      Commit_C($C, $S, <ch, sh>),
      Running_C($C, $S, <ch, sh, cf>),
      Accept($C, $S, key),
      Secret($C, $S, key) ]->
    [ Out(cf) ]

// Server: check pin, both signatures and the Finished MAC; accept.
rule Server_2:
    let idC    = <pkeC, pkdC>
        cf     = <'cf', idC, sc_e, sc_d, fin_c>
        th_cid = h(<'transcript', ch, sh, 'cf', idC>)
        m_c    = <'hybrid-sig', 'client signature', idC, th_cid>
        th_csg = h(<'transcript', ch, sh, 'cf', idC, sc_e, sc_d>)
        th_fin = h(<'transcript', ch, sh, cf>)
        key    = h(<'traffic', prk, th_fin>)
    in
    [ St_S1($S, ch, sh, prk), In(cf), !Pk($C, pkeC, pkdC) ]   // pinned client identity
  --[ Eq(verify_ed(sc_e, m_c, pkeC), true),
      Eq(verify_dsa(sc_d, m_c, pkdC), true),
      Eq(fin_c, h(<'hmac', h(<'c finished', prk>), th_csg>)),
      Commit_S($S, $C, <ch, sh, cf>),
      Accept($S, $C, key),
      Secret($S, $C, key) ]->
    [ ]

/* ───────────── lemmas ───────────── */

// Sanity: an honest run where both sides accept the same key, with no
// compromise at all, is possible.
lemma executable:
    exists-trace
    "Ex C S k #i #j.
        Accept(C, S, k) @i & Accept(S, C, k) @j & not (C = S)
      & not (Ex A #r. RevLtk(A) @r)
      & not (Ex #r. BreakEd() @r) & not (Ex #r. BreakDsa() @r)
      & not (Ex #r. BreakX() @r)  & not (Ex #r. BreakK() @r)"

// Session-key secrecy with forward secrecy. The key stays secret unless
//  (a) the attacker broke BOTH key-exchange primitives (passive decryption), or
//  (b) it could impersonate the peer: the peer's long-term key was revealed
//      BEFORE acceptance, or BOTH signature schemes were broken.
// Revealing long-term keys after acceptance does not help (forward secrecy).
lemma session_key_secrecy:
    "All A B k #i. Secret(A, B, k) @i ==>
        not (Ex #j. K(k) @j)
      | ((Ex #x. BreakX() @x) & (Ex #y. BreakK() @y))
      | (Ex #r. RevLtk(B) @r & #r < #i)
      | ((Ex #e. BreakEd() @e) & (Ex #d. BreakDsa() @d))"

// Server authentication to the client: if the client accepts a ServerHello
// from pinned server S, then S really sent it in reply to this ClientHello,
// unless S's keys leaked before or both signature schemes were broken.
// Note that RevLtk(C) is NOT an exception: compromising the client's own
// key does not let the attacker impersonate servers to it (KCI resistance).
lemma server_authentication:
    "All C S t #i. Commit_C(C, S, t) @i ==>
        (Ex #j. Running_S(S, t) @j & #j < #i)
      | (Ex #r. RevLtk(S) @r & #r < #i)
      | ((Ex #e. BreakEd() @e) & (Ex #d. BreakDsa() @d))"

// Client authentication to the server, injective: every accepted
// ClientFinish corresponds to a distinct run of client C with this server
// and this exact transcript (no replay), unless C's keys leaked before or
// both signature schemes were broken. KCI: RevLtk(S) is not an exception.
lemma client_authentication_injective:
    "All S C t #i. Commit_S(S, C, t) @i ==>
        ( (Ex #j. Running_C(C, S, t) @j & #j < #i)
          & not (Ex S2 C2 #i2. Commit_S(S2, C2, t) @i2 & not (#i2 = #i)) )
      | (Ex #r. RevLtk(C) @r & #r < #i)
      | ((Ex #e. BreakEd() @e) & (Ex #d. BreakDsa() @d))"

end
