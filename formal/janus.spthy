/*
 * Janus v1 handshake — Tamarin model.
 *
 * Symbolic (Dolev-Yao) model of the three-message handshake of
 * docs/PROTOCOL.md §6. The attacker controls the network and may, at any
 * time:
 *   - reveal any agent's long-term keys             (RevLtk),
 *   - break Ed25519 / ML-DSA-65 (sign as anyone)     (BreakEd / BreakDsa),
 *   - break X25519 / ML-KEM-768 (learn the shared
 *     secret of any session for that KEM)            (BreakX / BreakK).
 *
 * The lemmas state that each property holds unless the attacker broke
 * BOTH primitives of the relevant pair (or compromised the right long-term
 * key before the session). This is the hybrid claim of DESIGN.md §6.
 *
 * Abstractions (see formal/README.md):
 *   - SHA-384, HKDF and HMAC are a free hash over tagged tuples, and the
 *     streaming transcript hash is a hash chain (both are injective
 *     commitments to the same prefix);
 *   - ML-KEM-768 is an ideal KEM, and X25519 is modelled as a DHKEM (as in
 *     HPKE, RFC 9180): the server's share encapsulates a fresh secret to the
 *     client's ephemeral public key. There are no equations: breaking a KEM
 *     reveals the shared secrets it protects, which is the capability that
 *     decapsulation would give;
 *   - signatures are ideal, written as pattern matching (the usual Tamarin
 *     idiom): a receiver only accepts sign_ed(m, sk) where m is the message
 *     it expects and pk_ed(sk) is the pinned key. sign_ed is a free
 *     constructor, so the attacker can build such a term only if it knows
 *     sk. Tamarin warns that sk is "not derivable" in the receiving rules:
 *     that warning is expected for this idiom;
 *   - a ciphertext that is not an encapsulation to the client's key would,
 *     under ML-KEM implicit rejection, give an unrelated key, so the
 *     Finished check fails; the model simply only accepts well-formed ones.
 */

theory Janus
begin

builtins: hashing

// No equations: the term algebra is free. A KEM ciphertext encaps(k, pk)
// hides k; breaking the KEM is modelled by revealing k (rules Break_X /
// Break_K), which is exactly the capability decapsulation would give.
functions:
    pk_ed/1, sign_ed/2,
    pk_dsa/1, sign_dsa/2,
    kem_pk/1, encaps/2,          // ML-KEM-768
    x_pk/1, x_encaps/2           // X25519, as a DHKEM

/* ───────────── identities ───────────── */

// Every agent has one hybrid identity. A peer's public identity is
// obtained through !Pk, which models the pinned fingerprint: an agent only
// accepts the identity that is pinned for the peer it wants to talk to.
rule Register:
    [ Fr(~ske), Fr(~skd) ]
  --[ Register($A), OnlyOnce($A) ]->
    [ !Ltk($A, ~ske, ~skd), !Pk($A, pk_ed(~ske), pk_dsa(~skd)),
      Out(<$A, pk_ed(~ske), pk_dsa(~skd)>) ]

restriction register_once:
    "All A #i #j. OnlyOnce(A) @i & OnlyOnce(A) @j ==> #i = #j"

/* ───────────── compromise ───────────── */

rule Reveal_Ltk:
    [ !Ltk($A, ske, skd) ]  --[ RevLtk($A) ]->  [ Out(<ske, skd>) ]

// A broken signature scheme lets the attacker sign as anyone.
rule Break_Ed:
    [ !Ltk($A, ske, skd) ]  --[ BreakEd() ]->   [ Out(ske) ]

rule Break_Dsa:
    [ !Ltk($A, ske, skd) ]  --[ BreakDsa() ]->  [ Out(skd) ]

// A broken KEM lets the attacker recover any session's shared secret for
// that KEM (equivalently: decapsulate any ciphertext).
rule Break_X:
    [ !SsX(k) ]             --[ BreakX() ]->    [ Out(k) ]

rule Break_K:
    [ !SsK(k) ]             --[ BreakK() ]->    [ Out(k) ]

/* ───────────── handshake ───────────── */

/*
 * Transcript. The implementation hashes the growing transcript with
 * streaming SHA-384 (TH(x) for successive prefixes x). Here it is a hash
 * chain: th_n = h(<'th', th_{n-1}, new fields>). In the symbolic model both
 * are injective commitments to exactly the same prefix, and the chain keeps
 * terms small enough for Tamarin.
 */

// Client: ClientHello = <'ch', c_random, ML-KEM ek, X25519 share>.
rule Client_1:
    [ Fr(~x), Fr(~dk), Fr(~rc), !Ltk($C, skeC, skdC), !Pk($S, pkeS, pkdS) ]
  --[ ClientStart($C, $S) ]->
    [ St_C1($C, $S, ~x, ~dk, ~rc),
      Out(<'ch', ~rc, kem_pk(~dk), x_pk(~x)>) ]

// Server: encapsulate, derive prk from TH(kex) and ss_mlkem || ss_x25519,
// sign TH(.. || id_S) with both schemes, MAC TH(.. || sig_S).
// Every ML-KEM encapsulation key has the form kem_pk(dk); matching on it
// (rather than accepting an arbitrary term) avoids a partial deconstruction
// of encaps(~kk, ekC) without restricting the attacker.
rule Server_1:
    let ch     = <'ch', rc, kem_pk(dkC), x_pk(xC)>
        ct     = encaps(~kk, kem_pk(dkC))
        YS     = x_encaps(~kx, x_pk(xC))
        idS    = <pk_ed(skeS), pk_dsa(skdS)>
        th_kex = h(<'th', ch, 'sh', ~rs, ct, YS>)
        prk    = h(<'extract', th_kex, ~kk, ~kx>)
        th_id  = h(<'th', th_kex, idS>)
        m_s    = <'hybrid-sig', 'server signature', idS, th_id>
        sig_e  = sign_ed(m_s, skeS)
        sig_d  = sign_dsa(m_s, skdS)
        th_sig = h(<'th', th_id, sig_e, sig_d>)
        fin_s  = h(<'hmac', h(<'s finished', prk>), th_sig>)
        th_sh  = h(<'th', th_sig, fin_s>)
    in
    [ In(ch), Fr(~kx), Fr(~kk), Fr(~rs), !Ltk($S, skeS, skdS) ]
  --[ Running_S($S, th_sh) ]->
    [ St_S1($S, th_sh, prk), !SsK(~kk), !SsX(~kx),
      Out(<'sh', ~rs, ct, YS, idS, sig_e, sig_d, fin_s>) ]

// Client: check pin, both signatures and the Finished MAC; answer.
rule Client_2:
    let ch     = <'ch', ~rc, kem_pk(~dk), x_pk(~x)>
        idS    = <pk_ed(skeS), pk_dsa(skdS)>
        ct     = encaps(kk, kem_pk(~dk))
        YS     = x_encaps(kx, x_pk(~x))
        th_kex = h(<'th', ch, 'sh', rs, ct, YS>)
        prk    = h(<'extract', th_kex, kk, kx>)
        th_id  = h(<'th', th_kex, idS>)
        m_s    = <'hybrid-sig', 'server signature', idS, th_id>
        sig_e  = sign_ed(m_s, skeS)
        sig_d  = sign_dsa(m_s, skdS)
        th_sig = h(<'th', th_id, sig_e, sig_d>)
        fin_s  = h(<'hmac', h(<'s finished', prk>), th_sig>)
        th_sh  = h(<'th', th_sig, fin_s>)
        idC    = <pk_ed(skeC), pk_dsa(skdC)>
        th_cid = h(<'th', th_sh, 'cf', idC>)
        m_c    = <'hybrid-sig', 'client signature', idC, th_cid>
        sc_e   = sign_ed(m_c, skeC)
        sc_d   = sign_dsa(m_c, skdC)
        th_csg = h(<'th', th_cid, sc_e, sc_d>)
        fin_c  = h(<'hmac', h(<'c finished', prk>), th_csg>)
        th_fin = h(<'th', th_csg, fin_c>)
        key    = h(<'traffic', prk, th_fin>)
    in
    [ St_C1($C, $S, ~x, ~dk, ~rc),
      In(<'sh', rs, ct, YS, idS, sig_e, sig_d, fin_s>),
      !Ltk($C, skeC, skdC),
      !Pk($S, pk_ed(skeS), pk_dsa(skdS)) ]               // pinned server identity
  --[ Commit_C($C, $S, th_sh),
      Running_C($C, $S, th_fin),
      AcceptC($C, $S, key),
      Secret($C, $S, key) ]->
    [ Out(<'cf', idC, sc_e, sc_d, fin_c>) ]

// Server: check pin, both signatures and the Finished MAC; accept.
rule Server_2:
    let idC    = <pk_ed(skeC), pk_dsa(skdC)>
        th_cid = h(<'th', th_sh, 'cf', idC>)
        m_c    = <'hybrid-sig', 'client signature', idC, th_cid>
        sc_e   = sign_ed(m_c, skeC)
        sc_d   = sign_dsa(m_c, skdC)
        th_csg = h(<'th', th_cid, sc_e, sc_d>)
        fin_c  = h(<'hmac', h(<'c finished', prk>), th_csg>)
        th_fin = h(<'th', th_csg, fin_c>)
        key    = h(<'traffic', prk, th_fin>)
    in
    [ St_S1($S, th_sh, prk),
      In(<'cf', idC, sc_e, sc_d, fin_c>),
      !Pk($C, pk_ed(skeC), pk_dsa(skdC)) ]               // pinned client identity
  --[ Commit_S($S, $C, th_fin),
      AcceptS($S, $C, key),
      Secret($S, $C, key) ]->
    [ ]

/* ───────────── lemmas ───────────── */

// Sanity: an honest run where both sides accept the same key, with no
// compromise at all, is possible.
lemma executable:
    exists-trace
    "Ex C S k #i #j.
        AcceptC(C, S, k) @i & AcceptS(S, C, k) @j & not (C = S)
      & not (Ex A #r. RevLtk(A) @r)
      & not (Ex #r. BreakEd() @r) & not (Ex #r. BreakDsa() @r)
      & not (Ex #r. BreakX() @r)  & not (Ex #r. BreakK() @r)"

// Session-key secrecy with forward secrecy. The key stays secret unless
//  (a) the attacker broke BOTH key-exchange primitives (passive decryption), or
//  (b) it could impersonate the peer: the peer's long-term key was revealed
//      BEFORE acceptance, or BOTH signature schemes were broken.
// Revealing long-term keys after acceptance does not help (forward secrecy).
lemma session_key_secrecy:
    "All A B k #i. Secret(A, B, k) @i ==>
        not (Ex #j. K(k) @j)
      | ((Ex #x. BreakX() @x) & (Ex #y. BreakK() @y))
      | (Ex #r. RevLtk(B) @r & #r < #i)
      | ((Ex #e. BreakEd() @e) & (Ex #d. BreakDsa() @d))"

// Server authentication to the client: if the client accepts a ServerHello
// from pinned server S, then S really sent it in reply to this ClientHello,
// unless S's keys leaked before or both signature schemes were broken.
// Note that RevLtk(C) is NOT an exception: compromising the client's own
// key does not let the attacker impersonate servers to it (KCI resistance).
lemma server_authentication:
    "All C S t #i. Commit_C(C, S, t) @i ==>
        (Ex #j. Running_S(S, t) @j & #j < #i)
      | (Ex #r. RevLtk(S) @r & #r < #i)
      | ((Ex #e. BreakEd() @e) & (Ex #d. BreakDsa() @d))"

// Client authentication to the server, injective: every accepted
// ClientFinish corresponds to a distinct run of client C with this server
// and this exact transcript (no replay), unless C's keys leaked before or
// both signature schemes were broken. KCI: RevLtk(S) is not an exception.
lemma client_authentication_injective:
    "All S C t #i. Commit_S(S, C, t) @i ==>
        ( (Ex #j. Running_C(C, S, t) @j & #j < #i)
          & not (Ex S2 C2 #i2. Commit_S(S2, C2, t) @i2 & not (#i2 = #i)) )
      | (Ex #r. RevLtk(C) @r & #r < #i)
      | ((Ex #e. BreakEd() @e) & (Ex #d. BreakDsa() @d))"

end
